1|(()=>{HOLE_OPEN=true;const bad=[];for(let s=0;s<ROAD_LEN-1;s+=1){const p=roadPt(s).clone();const d=playD(p.x,p.z);if(d>-0.3)bad.push(Math.round(s)+':'+d.toFixed(1));}for(const id in HOLDS){}return 'bad='+bad.slice(0,30).join(' ')+' n='+bad.length+' len W/E '+(FLANK.len.W|0)+'/'+(FLANK.len.E|0)+' fy drop '+floorAt(spiralPt(TH_DROP,43).x,spiralPt(TH_DROP,43).z).toFixed(1)+' '+floorAt(spiralPt(TH_DROP,48).x,spiralPt(TH_DROP,48).z).toFixed(1)})()
