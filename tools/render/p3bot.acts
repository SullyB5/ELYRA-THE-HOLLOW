0|(()=>{window.__god=setInterval(()=>{if(window.P){P.hp=P.maxHp;}},100);return 'god'})()
1|(()=>{let last='',lk=0;window.__bot=setInterval(()=>{const ph=phase+(doorOpening&&doorOpen<1?':door':'');if(ph!==last){last=ph;const m='T='+(window.__gameT/1000).toFixed(1)+' '+ph+' s='+roadS(P.pos.x,P.pos.z).toFixed(0)+' foes='+ENEMIES.filter(E=>!E.H.dead).length+' pos='+P.pos.x.toFixed(0)+','+P.pos.y.toFixed(1)+','+P.pos.z.toFixed(0);console.warn(m);} if(CUTS.on||!P.input)return; if(++lk%8===0)for(const E of ENEMIES)if(!E.H.dead&&!E.gunner)hurtEnemy(E,99999,'gun'); if(typeof MECH!=='undefined'&&MECH.list)for(const M0 of MECH.list)if(!M0.dead&&MECH.hurt)MECH.hurt(M0,99999); if(phase==='flank'){const u=flankU(P.pos.x,P.pos.z,'W');const p=flankAt('W',u+1.6,0);P.pos.set(p.x,groundY(p.x,p.z),p.z);return;} if(phase==='streets'||phase==='ramp'||phase==='chamber'){if(doorOpening&&doorOpen<1)return;const s=roadS(P.pos.x,P.pos.z);if(phase==='chamber'&&Math.hypot(P.pos.x,P.pos.z-2.6)<1.2)return;const p=phase==='chamber'&&s>S_UW1+6?V3(P.pos.x+(0-P.pos.x)*.3,TOPY,P.pos.z+(2.6-P.pos.z)*.3):at(s+1.6,0);P.pos.set(p.x,groundY(p.x,p.z),p.z);}},200);return 'bot'})()
