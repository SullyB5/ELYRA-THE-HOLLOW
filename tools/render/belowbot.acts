0|(()=>{window.__god=setInterval(()=>{if(window.P){P.hp=P.maxHp;}},100);return 'god'})()
1|(()=>{window.BELOW_HOLD_K=.15;let last='',lk=0;window.__log=[];window.__bot=setInterval(()=>{const ph=phase+(BELOW.hold?':'+BELOW.hold.id:'');if(ph!==last){last=ph;const m='T='+(window.__gameT/1000).toFixed(1)+' '+ph+' s='+belowS(P.pos.x,P.pos.z).toFixed(0)+' foes='+ENEMIES.filter(E=>!E.H.dead&&E.pos.x<-1600).length;__log.push(m);console.warn(m);}if(CUTS.on||!P.input)return;if(++lk%8===0)for(const E of ENEMIES)if(!E.H.dead&&E.pos.x<-1600)hurtEnemy(E,99999,'gun');if(phase==='below'||phase==='climb'){if(BELOW.hold)return;const s=belowS(P.pos.x,P.pos.z);if(phase==='below'&&s>BS.codex-2)return;const p=belowPt(s+1.6);P.pos.set(p.x,p.y,p.z);}},200);return 'bot'})()
